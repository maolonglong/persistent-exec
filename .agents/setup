#!/usr/bin/env bash
set -euo pipefail

step() {
  local label="$1"
  shift
  echo "==> $label"
  local started=$SECONDS
  "$@"
  echo "<== $label completed in $((SECONDS - started))s"
}

install_system_packages() {
  local packages=(build-essential pkg-config)
  local missing=()
  local package

  for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
      missing+=("$package")
    fi
  done

  if ((${#missing[@]} == 0)); then
    echo "System packages are already installed"
    return
  fi

  local apt=(apt-get)
  if ((EUID != 0)); then
    apt=(sudo apt-get)
  fi
  "${apt[@]}" update
  "${apt[@]}" install -y "${missing[@]}"
}

install_rust() {
  if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
      sh -s -- -y --profile minimal --default-toolchain none --no-modify-path
  fi

  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
  rustup toolchain install 1.98.0 --profile minimal --component clippy --component rustfmt

  local profile_line='[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"'
  touch "$HOME/.bash_profile"
  if ! grep -Fqx "$profile_line" "$HOME/.bash_profile"; then
    printf '\n%s\n' "$profile_line" >>"$HOME/.bash_profile"
  fi
}

check_javascript_toolchain() {
  command -v node
  command -v npm
  command -v bun
  node --version
  npm --version
  bun --version
}

install_npm_dependencies() {
  npm install --ignore-scripts --package-lock=false

  # Development builds must load the locally built FFI library, not a published platform binary.
  rm -rf node_modules/persistent-exec-bin-*
}

step "Checking system packages" install_system_packages
step "Installing the pinned Rust toolchain" install_rust
step "Checking the JavaScript toolchain" check_javascript_toolchain
step "Installing npm dependencies" install_npm_dependencies
